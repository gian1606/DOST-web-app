# ── BE-SMART Web App Environment ─────────────────────────────────────────────
# VITE_ prefix exposes variables to the browser bundle.
# This key must match QR_SECRET_KEY in DOST-api/.env exactly.
VITE_QR_SECRET_KEY=be-smart-dev-secret-change-in-prod

# API base URL — update when backend is deployed
VITE_API_BASE_URL=http://localhost:4000
